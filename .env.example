# ============================================================
# GitOps Secret Shield – Phase 2 Environment Template
# Copy to .env.prod and fill in real values
# NEVER commit .env.prod to version control
# ============================================================

ENVIRONMENT=production

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=shielduser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=secret_shield
DATABASE_URL=postgresql+psycopg2://shielduser:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/secret_shield

# ── HashiCorp Vault ───────────────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=CHANGE_ME_VAULT_TOKEN

# ── GitHub Integration ────────────────────────────────────
GITHUB_WEBHOOK_SECRET=CHANGE_ME_GITHUB_WEBHOOK_SECRET
GITHUB_TOKEN=

# ── JWT Authentication (Phase 2) ──────────────────────────
JWT_SECRET_KEY=CHANGE_ME_MINIMUM_32_CHAR_RANDOM_JWT_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
DEV_PASSWORD=CHANGE_ME_STRONG_DEV_PASSWORD

# ── Rate Limiting (Phase 2) ───────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_AUTH_REQUESTS=10

# ── CORS (Phase 2) ────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ── Email Alerting (Phase 2) ──────────────────────────────
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=gitops-shield@yourdomain.com
ALERT_EMAIL_TO=security-team@yourdomain.com
ALERT_SMTP_HOST=smtp.yourmailprovider.com
ALERT_SMTP_PORT=587
ALERT_SMTP_TLS=true
ALERT_SMTP_USER=
ALERT_SMTP_PASS=

# ── Slack Alerting (Phase 2) ──────────────────────────────
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
